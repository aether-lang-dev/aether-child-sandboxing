// The Python showcase's host: runs python/guest.py in a sandboxed child
// process (sandbox.spawn_socket) and talks to it, both ways, over std.ipc.
//
// The guest is the stock python3 with nothing added: no Aether bridge, no
// libpython ABI to match. It gets one thing, the socket at fd 3, and asks
// the host for everything else.
//
// Run (from the repo root): make python
//   args: [stall] [uncontained]
//   stall        the guest goes quiet after HELLO: the deadline kills it
//   uncontained  sandbox.spawn_socket_uncontained, by name (make UNCONTAINED=1)

import std.io
import std.list
import std.os
import std.sandbox
import childbox

const GUEST = "python/guest.py"

main() {
    stall = 0
    uncontained = 0
    i = 1
    while i < os.args_count() {
        if os.args_get(i) == "stall" { stall = 1 }
        if os.args_get(i) == "uncontained" { uncontained = 1 }
        i = i + 1
    }

    // What the guest may do on its own: read the interpreter's own library,
    // which python3 itself is asked for (no platform paths here), and its
    // script. Nothing else: no files of ours, no network, no processes.
    guest = sandbox.new("python-guest") {
        grant_runtime("python3")
        grant_fs_read("${os.getcwd()}/${GUEST}")
    }
    defer sandbox.free(guest)

    // What the guest may ASK for: one logical name, mapped to a file here.
    policy = |name: string| {
        if name == "config" { return "data/config.txt" }
        return ""
    }

    session = if stall == 1 { "python-stall" } else { "python" }
    childbox.audit_log("--- session: ${session}")
    argv = list.new()
    list.add(argv, "-I")
    list.add(argv, GUEST)
    if stall == 1 { list.add(argv, "stall") }
    ch, pid, err = childbox.start_guest(guest, "python3", argv, uncontained)
    list.free(argv)
    if err != "" {
        println("spawn refused: ${err}")
        exit(1)
    }

    println("conversation (permission decisions also go to ${childbox.AUDIT_LOG}):")
    cerr = childbox.converse(ch, session, policy)
    if cerr != "" {
        // A guest that broke the protocol or went quiet may still be
        // running: hang up and stop it rather than wait on it.
        println("conversation ended: ${cerr}")
        io.fd_close(ch)
        os.kill(pid, 9)
        childbox.audit_log("${session} KILLED after: ${cerr}")
        println("  host: guest killed")
    } else {
        io.fd_close(ch)
    }
    os.wait_pid(pid)
}
