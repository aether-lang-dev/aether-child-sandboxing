// The RexxAE showcase's host: runs the Rexx guest (build/rexx-guest, the
// worker around rexx/chat.rexx) in a child process and talks to it, both
// ways, over std.ipc. The child is meant to be sandboxed; it will be once
// the proposed spawn exists (README, "What's left"). The same conversation as python/host.ae, line for
// line; only the guest differs.
//
// Run (from the repo root): make rexx

import std.io
import std.list
import std.os
import std.sandbox
import childbox

main() {
    // What the guest may do on its own: read its script. Nothing else:
    // no files of ours, no network, no processes.
    // NOT ENFORCED YET: sandbox.spawn_socket would hold the child to these;
    // the uncontained stand-in below takes them and ignores them.
    guest = sandbox.new("rexx-guest") {
        grant_fs_read("rexx/chat.rexx")
    }
    defer sandbox.free(guest)

    // What the guest may ASK for: one logical name, mapped to a file here.
    policy = |name: string| {
        if name == "config" { return "data/config.txt" }
        return ""
    }

    argv = list.new()
    ch, pid, err = childbox.spawn_socket_uncontained(guest, "build/rexx-guest", argv)
    list.free(argv)
    if err != "" {
        println("spawn failed: ${err}")
        exit(1)
    }

    println("conversation (permission decisions also go to ${childbox.AUDIT_LOG}):")
    cerr = childbox.converse(ch, "rexx", policy)
    if cerr != "" {
        // A guest that broke the protocol may still be writing: hang up and
        // stop it, rather than wait on a child blocked on a full socket.
        println("conversation failed: ${cerr}")
        io.fd_close(ch)
        os.kill(pid, 9)
    }
    os.wait_pid(pid)
}
