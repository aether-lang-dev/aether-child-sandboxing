// The RexxAE showcase's host: runs rexx/chat.rexx in RexxAE's worker
// process (../RexxAE/worker, build/worker/rexxae-worker) under
// sandbox.spawn_socket, and talks to it over std.ipc. The same
// conversation as python/host.ae, line for line; only the guest differs.
//
// The worker is RexxAE's generic one, on Aether's std.guest.child: any
// script, any mounted functions; this host drives it with std.guest. It
// locks itself down with sandbox.enforce and no grants before the script's
// first step, and answers the host's CANCEL with rexxae_cancel. This host
// mounts three functions, each answered here:
//   HOST_HEAR()          the host's next message
//   HOST_TELL(line)      a message to the host
//   HOST_REQUEST(name)   ask for a file: {"granted":true,"text":...}, or no
// std.guest bounds every exchange with a deadline: a script waiting in
// HOST_HEAR for a message that never comes is cancelled, not left to hang
// the host.
//
// Run (from the repo root): make rexx
//   args: <worker program> [stuck] [uncontained]
//   stuck        run rexx/stuck.rexx: it HEARs when the host has nothing
//   uncontained  guest.launch_uncontained, by name (make UNCONTAINED=1)

import std.fs
import std.os
import std.sandbox
import std.guest
import childbox

main() {
    if os.args_count() < 2 {
        println("usage: host <rexxae-worker> [stuck] [uncontained]")
        exit(2)
    }
    prog = os.args_get(1)
    stuck = 0
    uncontained = 0
    i = 2
    while i < os.args_count() {
        if os.args_get(i) == "stuck" { stuck = 1 }
        if os.args_get(i) == "uncontained" { uncontained = 1 }
        i = i + 1
    }
    script = if stuck == 1 { "rexx/stuck.rexx" } else { "rexx/chat.rexx" }
    session = if stuck == 1 { "rexx-stuck" } else { "rexx" }
    source, serr = fs.read(script)
    if serr != "" {
        println("cannot read ${script}: ${serr}")
        exit(1)
    }

    // What the worker may do on its own: nothing. It is one binary with the
    // engine compiled in, and its script comes over the socket.
    perms = sandbox.new("rexx-guest") {
    }
    defer sandbox.free(perms)

    // What the guest may ASK for: one logical name, mapped to a file here.
    policy = |name: string| {
        if name == "config" { return "data/config.txt" }
        return ""
    }

    childbox.audit_log("--- session: ${session}")
    w, err = start_worker(perms, prog, session, uncontained)
    if err != "" {
        println("spawn refused: ${err}")
        exit(1)
    }
    if uncontained == 1 {
        println("[rexx host] guest.launch_uncontained: the worker runs with NO process sandbox")
    }
    guest.mount(&w, "HOST_HEAR", 0, 0)
    guest.mount(&w, "HOST_TELL", 1, 1)
    guest.mount(&w, "HOST_REQUEST", 1, 1)
    if stuck == 0 { guest.probe(&w) }
    guest.start(&w, source)

    childbox.converse(&w, session, "HOST_HEAR", "HOST_TELL", "HOST_REQUEST", policy)
}

// The worker in sandbox.spawn_socket, or, asked for by name, without it.
start_worker(perms: sandbox.Grants, prog: string, session: string, uncontained: int) -> (guest.Guest, string) {
    if uncontained == 1 {
        return guest.launch_uncontained(perms, prog, null, session, childbox.AUDIT_LOG)
    }
    return guest.launch(perms, prog, null, session, childbox.AUDIT_LOG)
}
