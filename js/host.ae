// The JavaScript showcase's host: runs js/chat.js on MicroQuickJS
// (mquickjs-ae) in js-worker (js/worker.ae, built by js/.build.ae) under
// sandbox.spawn_socket, and talks to it over std.ipc. The same
// conversation as python/host.ae and rexx/host.ae, line for line.
//
// js-worker is built on Aether's std.guest.child, and this host drives it
// with std.guest, the same module rexx/host.ae drives RexxAE's worker with.
// The worker locks itself down with sandbox.enforce and no grants before
// the first JavaScript runs, and answers CANCEL from inside the engine
// (MicroQuickJS's interrupt hook). This host mounts three functions:
//   hostHear()           the host's next message
//   hostTell(line)       a message to the host
//   hostRequest(name)    ask for a file: {granted:true, text:...}, or no
//
// Run (from the repo root): make js
//   args: <worker program> [stuck | deaf | big] [uncontained]
//   stuck        js/stuck.js: while (true) {}, cancelled at the deadline
//   deaf         the program is a stand-in that never answers: killed
//   big          js/big.js: a frame over 64 KiB, refused
//   uncontained  guest.launch_uncontained, by name (make UNCONTAINED=1)

import std.fs
import std.os
import std.sandbox
import std.guest
import childbox

main() {
    if os.args_count() < 2 {
        println("usage: host <js-worker> [stuck | deaf | big] [uncontained]")
        exit(2)
    }
    prog = os.args_get(1)
    mode = ""
    uncontained = 0
    i = 2
    while i < os.args_count() {
        a = os.args_get(i)
        if a == "uncontained" { uncontained = 1 } else { mode = a }
        i = i + 1
    }
    script = "js/chat.js"
    session = "js"
    if mode == "stuck" {
        script = "js/stuck.js"
        session = "js-stuck"
    } else if mode == "deaf" {
        session = "js-deaf"
    } else if mode == "big" {
        script = "js/big.js"
        session = "js-big"
    }
    source, serr = fs.read(script)
    if serr != "" {
        println("cannot read ${script}: ${serr}")
        exit(1)
    }

    // What the worker may do on its own: nothing. It is one binary with the
    // engine compiled in, and its script comes over the socket.
    perms = sandbox.new("js-guest") {
    }
    defer sandbox.free(perms)

    // What the guest may ASK for: one logical name, mapped to a file here.
    policy = |name: string| {
        if name == "config" { return "data/config.txt" }
        return ""
    }

    childbox.audit_log("--- session: ${session}")
    w, err = start_worker(perms, prog, session, uncontained)
    if err != "" {
        println("spawn refused: ${err}")
        exit(1)
    }
    if uncontained == 1 {
        println("[js host] guest.launch_uncontained: the worker runs with NO process sandbox")
    }
    guest.mount(&w, "hostHear", 0, 0)
    guest.mount(&w, "hostTell", 1, 1)
    guest.mount(&w, "hostRequest", 1, 1)
    if mode == "" { guest.probe(&w) }
    guest.start(&w, source)

    childbox.converse(&w, session, "hostHear", "hostTell", "hostRequest", policy)
}

// The worker in sandbox.spawn_socket, or, asked for by name, without it.
start_worker(perms: sandbox.Grants, prog: string, session: string, uncontained: int) -> (guest.Guest, string) {
    if uncontained == 1 {
        return guest.launch_uncontained(perms, prog, null, session, childbox.AUDIT_LOG)
    }
    return guest.launch(perms, prog, null, session, childbox.AUDIT_LOG)
}
