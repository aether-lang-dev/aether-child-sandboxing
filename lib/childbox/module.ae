// childbox: the showcase's conversation, the same for every guest language.
// The transport, the deadlines, the descriptor hand-over, cancel and kill
// and the audit log's lines about them are Aether's std.guest; what is here
// is what the host says, and the one audit log all three showcases share.
//
//   host  HELLO              guest HELLO
//   host  ASK multiply 6 7   guest ANSWER 42
//                            guest REQUEST config    host GRANT, fd passed
//                            guest SAY <from the file>
//                            guest REQUEST /etc/passwd  host DENY
//                            guest PROBE <its own escape attempts>
//                            guest DONE
//   host  BYE                guest BYE
//
// Each guest has three functions the host mounts, named in its language's
// style (HOST_HEAR, hostHear, host_hear): hear (the host's next message),
// tell (a message to the host) and request (ask for a file by name).

exports(converse, respond, show, audit_log, AUDIT_LOG)

import std.io
import std.json
import std.list
import std.string
import std.guest

const AUDIT_LOG = "build/audit.log"

// A line in the shared audit log (std.guest writes its own there too).
audit_log(line: string) {
    io.append_file(AUDIT_LOG, "${line}\n")
}

// Prints one message of the conversation with its direction. Everything a
// guest sent goes through guest.printable first.
show(from: string, to: string, line: string) {
    println("  ${from} -> ${to}  ${guest.printable(line)}")
}

// What the host says to one line the guest told it: adds the host's
// answers to `out`, a std.list of strings, shown as they are decided.
respond(session: string, line: string, out: ptr) {
    show(session, "host", line)
    verb, _ = split_verb(line)
    if verb == "HELLO" {
        show("host", session, "ASK multiply 6 7")
        list.add(out, "ASK multiply 6 7")
    } else if verb == "DONE" {
        show("host", session, "BYE")
        list.add(out, "BYE")
    }
}

// The whole conversation with a guest that has mounted `hear`, `tell` and
// `request` and been started. `policy` maps a name the guest may ask for
// to a path on the host's disk, or "" for no. Ends at the guest's DONE,
// ERROR or KILLED, which it prints.
converse(g: *guest.Guest, session: string, hear: string, tell: string, request: string, policy: fn) {
    println("conversation (permission decisions also go to ${AUDIT_LOG}):")
    // What the host has to say, waiting for the guest's next hear.
    outbox = list.new()
    defer list.free(outbox)
    hello = "HELLO from the Aether host"
    show("host", session, hello)
    list.add(outbox, hello)
    while true {
        e = guest.next(g)
        if e.kind == "CALL" {
            arg = first_arg(e.text)
            if e.name == hear {
                if list.size(outbox) > 0 {
                    line, _ = list.get_string(outbox, 0)
                    list.remove(outbox, 0)
                    guest.answer(g, guest.json_string(line))
                }
                // Nothing to say: no answer. The deadline decides.
            } else if e.name == tell {
                respond(session, arg, outbox)
                guest.answer(g, "true")
            } else if e.name == request {
                show(session, "host", "REQUEST ${arg}")
                string path = policy(arg)
                if path == "" {
                    show("host", session, "DENY ${arg}: not in this guest's policy")
                    guest.deny(g, arg, "not in this guest's policy")
                } else {
                    show("host", session, "GRANT ${arg}   (then ${path} as an open descriptor)")
                    guest.grant_file(g, arg, path)
                }
            } else {
                guest.fail(g, "${e.name} is not served here")
            }
        } else if e.kind == "SAY" {
            show(session, "host", "SAY ${e.text}")
        } else if e.kind == "DONE" {
            println("  worker: done, exit ${e.code}")
            return
        } else if e.kind != "LOG" {
            println("  worker: ${e.kind} ${guest.printable(e.text)}")
            return
        }
    }
}

// The one argument in a JSON array of arguments, as text.
fn first_arg(args: string) -> string {
    v, perr = json.parse(args)
    if perr != "" { return "" }
    el, aerr = json.array_get(v, 0)
    text = ""
    if aerr == "" {
        s, gerr = json.get_string(el)
        if gerr == "" { text = s }
    }
    json.json_free(v)
    return text
}

// "VERB the rest" -> ("VERB", "the rest").
fn split_verb(line: string) -> (string, string) {
    at = string.index_of(line, " ")
    if at < 0 { return line, "" }
    return string.substring(line, 0, at), string.substring(line, at + 1, string.length(line))
}
