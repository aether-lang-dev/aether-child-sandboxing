// childbox: what an Aether host needs to talk to a guest it has put in a
// child process (sandboxed once the proposed spawn exists). Shared by the
// RexxAE and the Python showcase.
//
// Four parts:
//   - Wire: length-prefixed messages over a std.ipc socket channel, with a
//     maximum frame size, plus the handshake that hands the guest an open
//     file descriptor.
//   - converse: the host's side of the showcase conversation, the same for
//     every guest language.
//   - audit_log: one log for both kinds of permission, the host's GRANTs
//     and DENYs and what the guest's own sandbox reports.
//   - spawn_socket_uncontained: the stand-in for sandbox.spawn_socket, the
//     spawn this repo proposes (aether#3503). Aether does not have it yet.

exports(Wire, wire_new, tell, hear, grant_fd, take_fd, spawn_socket_uncontained,
        converse, audit_log, printable, MAX_FRAME, AUDIT_LOG)

import std.io
import std.ipc
import std.list
import std.os
import std.sandbox
import std.string

// The largest message either side accepts. A peer that announces more, or
// never finishes a header, is cut off rather than buffered without end.
const MAX_FRAME = 65536
// "65536:" is the longest header: up to 5 digits, then the colon.
const MAX_HEADER = 6

const AUDIT_LOG = "build/audit.log"

// A channel, and what has arrived on it past the last message read.
struct Wire {
    ch: int
    pending: string
}

wire_new(ch: int) -> Wire {
    return Wire { ch: ch, pending: "" }
}

// Framing: each message is its length in bytes, in decimal, a colon, and
// the bytes ("12:ANSWER 42 x"). Length-prefixed, not by line, so a payload
// may hold any byte (CBOR has 0x0a in it), and capped at MAX_FRAME. This is
// the frame reader aether#3503 proposes std.ipc should have, written out
// here until it does.

// Sends one message.
tell(w: *Wire, msg: string) -> string {
    size = string.length(msg)
    if size > MAX_FRAME { return "message of ${size} bytes is over MAX_FRAME" }
    return ipc.write(w.ch, "${size}:${msg}")
}

// The next message, however its bytes arrive. ("", "end of stream") when
// the other side has closed; an error, and nothing more buffered, when it
// sends a bad header or a frame over MAX_FRAME. At most one frame and one
// read's worth of bytes are ever held.
hear(w: *Wire) -> (string, string) {
    while true {
        colon = string.index_of(w.pending, ":")
        if colon >= 0 {
            size, herr = frame_size(w.pending, colon)
            if herr != "" { return "", herr }
            start = colon + 1
            if string.length(w.pending) - start >= size {
                msg = string.substring(w.pending, start, start + size)
                w.pending = string.substring(w.pending, start + size, string.length(w.pending))
                return msg, ""
            }
        } else if string.length(w.pending) >= MAX_HEADER {
            return "", "bad frame header (no length within ${MAX_HEADER} bytes)"
        }
        part, err = ipc.read(w.ch, 4096)
        if err != "" { return "", err }
        if string.length(part) == 0 { return "", "end of stream" }
        w.pending = string.concat(w.pending, part)
    }
}

// The length in a header that ends at `colon`: decimal digits only, at
// most MAX_FRAME.
frame_size(pending: string, colon: int) -> (int, string) {
    if colon == 0 || colon >= MAX_HEADER { return 0, "bad frame header" }
    size = 0
    i = 0
    while i < colon {
        c = string.char_at(pending, i)
        if c < 48 || c > 57 { return 0, "bad frame header (not a length)" }
        size = size * 10 + (c - 48)
        i = i + 1
    }
    if size > MAX_FRAME { return 0, "frame of ${size} bytes is over MAX_FRAME" }
    return size, ""
}

// Passing a descriptor is three steps, not one (see README, "Questions"):
//   host  -> guest   GRANT <name>       a plain message
//   guest -> host    TAKE <name>        "my next read is the descriptor"
//   host  -> guest   <descriptor>       ipc.send_fd, payload <name>
// A plain read that met the descriptor's bytes would drop the descriptor,
// and ipc.recv_fd refuses a message that has none, so the guest says when
// it is about to take one.

// The host's half: answers GRANT, waits for TAKE, passes `fd`.
grant_fd(w: *Wire, name: string, fd: int) -> string {
    err = tell(w, "GRANT ${name}")
    if err != "" { return err }
    take, rerr = hear(w)
    if rerr != "" { return rerr }
    if take != "TAKE ${name}" { return "expected 'TAKE ${name}', got '${take}'" }
    return ipc.send_fd(w.ch, fd, name)
}

// The guest's half, for a guest written in Aether: says TAKE, then takes
// the descriptor. Only valid with nothing unread pending.
take_fd(w: *Wire, name: string) -> (int, string) {
    if string.length(w.pending) != 0 { return -1, "unread bytes before a descriptor" }
    err = tell(w, "TAKE ${name}")
    if err != "" { return -1, err }
    fd, payload, ferr = ipc.recv_fd(w.ch, 256)
    if ferr != "" { return -1, ferr }
    if payload != name {
        io.fd_close(fd)
        return -1, "descriptor came for '${payload}', not '${name}'"
    }
    return fd, ""
}

// THE STAND-IN. The API this repo proposes (aether#3503) is
//
//     sandbox.spawn_socket(perms, prog, argv, env) -> (fd, pid, err)
//
// os.run_socket's channel plus spawn_sandboxed's containment, held to
// `perms`, in the sandbox namespace because containment is the point. It
// fails closed: where it cannot contain the child (macOS and Windows today)
// it refuses to start it. Running a guest uncontained is something a host
// has to ask for by name, never what a forgotten argument does.
//
// Aether does not have it yet, so both hosts here ask for exactly that by
// name: this runs the guest with plain os.run_socket, the same channel and
// NO containment. `perms` is taken and ignored. It says so on every run,
// and the guest's probes report what they got.
spawn_socket_uncontained(perms: sandbox.Grants, prog: string, argv: ptr) -> (int, int, string) {
    _ = perms
    println("[childbox] spawn_socket_uncontained: the guest runs with NO process sandbox")
    println("[childbox] (sandbox.spawn_socket, which would contain it, does not exist yet)")
    return os.run_socket(prog, argv, null)
}

// Records one permission decision. Both kinds land here, in one file: the
// host's answers to the guest's requests (GRANT, DENY) and what the guest
// reports from its own sandbox (AUDIT messages). Lines that came from the
// guest say so, and are escaped, since a guest chooses their bytes.
audit_log(event: string) {
    err = io.append_file(AUDIT_LOG, "${event}\n")
    if err != "" { println("[childbox] audit log ${AUDIT_LOG}: ${err}") }
}

// `s` safe to print or log: control bytes and backslashes as \xNN, so a
// guest cannot forge a line or send escape sequences to a terminal.
printable(s: string) -> string {
    hex = "0123456789abcdef"
    out = ""
    run = 0
    i = 0
    n = string.length(s)
    while i < n {
        c = string.char_at(s, i)
        if c >= 0 && (c < 32 || c == 127 || c == 92) {
            out = string.concat(out, string.substring(s, run, i))
            hi = c / 16
            lo = c % 16
            out = string.concat(out, "\\x${string.substring(hex, hi, hi + 1)}${string.substring(hex, lo, lo + 1)}")
            run = i + 1
        }
        i = i + 1
    }
    return string.concat(out, string.substring(s, run, n))
}

// Prints one message of the conversation with its direction. Everything a
// guest sent goes through printable first.
show(from: string, to: string, line: string) {
    println("  ${from} -> ${to}  ${printable(line)}")
}

// The host's side of the showcase, the same for every guest:
//
//   host  HELLO              guest HELLO
//   host  ASK multiply 6 7   guest ANSWER 42
//                            guest REQUEST config    host GRANT, fd passed
//                            guest SAY <from the file>
//                            guest REQUEST /etc/passwd  host DENY
//                            guest PROBE <its own escape attempts>
//                            guest AUDIT <its sandbox's own record>
//                            guest DONE
//   host  BYE                guest BYE
//
// Either side starts exchanges: the host asks the guest a question, and
// the guest asks the host for files. `policy` maps a name the guest may
// ask for to a path on the host's disk, or "" for no.
converse(ch: int, guest: string, policy: fn) -> string {
    audit_log("--- session: ${guest}")
    w = wire_new(ch)
    hello = "HELLO from the Aether host"
    show("host", guest, hello)
    err = tell(&w, hello)
    if err != "" { return err }
    while true {
        line, rerr = hear(&w)
        if rerr != "" { return "guest went away: ${rerr}" }
        show(guest, "host", line)
        verb, rest = split_verb(line)
        if verb == "HELLO" {
            ask = "ASK multiply 6 7"
            show("host", guest, ask)
            err = tell(&w, ask)
        } else if verb == "REQUEST" {
            err = answer_request(&w, guest, rest, policy)
        } else if verb == "AUDIT" {
            audit_log("${guest} reports: ${printable(rest)}")
        } else if verb == "DONE" {
            show("host", guest, "BYE")
            err = tell(&w, "BYE")
        } else if verb == "BYE" {
            return ""
        }
        if err != "" { return err }
    }
}

// GRANT and pass the file, or DENY.
answer_request(w: *Wire, guest: string, name: string, policy: fn) -> string {
    string path = policy(name)
    if path == "" {
        deny = "DENY ${name}: not in this guest's policy"
        audit_log("${guest} DENY ${printable(name)}: not in policy")
        show("host", guest, deny)
        return tell(w, deny)
    }
    fd, oerr = io.fd_open_read(path)
    if oerr != "" {
        deny = "DENY ${name}: ${oerr}"
        audit_log("${guest} DENY ${printable(name)}: ${oerr}")
        show("host", guest, deny)
        return tell(w, deny)
    }
    audit_log("${guest} GRANT ${printable(name)} -> ${path}")
    show("host", guest, "GRANT ${name}   (then ${path} as an open descriptor)")
    err = grant_fd(w, name, fd)
    io.fd_close(fd)
    return err
}

// "VERB the rest" -> ("VERB", "the rest").
split_verb(line: string) -> (string, string) {
    at = string.index_of(line, " ")
    if at < 0 { return line, "" }
    return string.substring(line, 0, at), string.substring(line, at + 1, string.length(line))
}
